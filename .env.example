# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" con valores reales al repositorio.

# Cadena de conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/ml_price_tracker

# Las credenciales de los usuarios viven en la tabla User (ver
# app/models.py), no en variables de entorno. El primer usuario admin se
# crea con: python scripts/create_admin.py

# Clave secreta usada para firmar tokens/sesiones.
# Generar una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
